package ui

templ pageLayout(title, token string, architecture bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			if architecture {
				<meta name="seamgraph-token" content={ token }/>
			}
			<title>{ "SeamGraph · " + title }</title>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<script src="/assets/navigation.js" defer></script>
			if title=="Code" || title=="Review" {
				<link rel="stylesheet" href="/assets/highlight.css"/>
				<script src="/assets/source.js" defer></script>
			}
			if architecture {
				<script src="/assets/htmx.min.js" defer></script>
				<script src="/assets/cytoscape.min.js" defer></script>
				<script src="/assets/graph.js" defer></script>
				<script src="/assets/app.js" defer></script>
			}
		</head>
		<body class="explorer bg-slate-950 text-slate-100 font-sans">
			@pageHeader(title, architecture)
			<div id="view-loading" class="view-loading" role="status" aria-live="polite" hidden><span class="details-spinner" aria-hidden="true"></span><span>Loading view…</span></div>
			{ children... }
		</body>
	</html>
}

templ pageHeader(title string, architecture bool) {
	<header class="app-header border-b border-slate-800">
		<div><span class="text-emerald-400 font-mono text-lg">◈</span><strong class="ml-3 text-xl tracking-tight">SeamGraph</strong><span class="app-subtitle ml-4 text-xs text-slate-400 uppercase tracking-widest">Local architecture explorer</span></div>
		@pageNavigation(title)
		if architecture {
			<span id="summary" class="page-context text-sm text-slate-400">Loading architecture…</span>
		} else {
			<span class="page-context text-sm text-slate-400">{ title }</span>
		}
	</header>
}

templ pageNavigation(active string) {
	<nav aria-label="Main navigation" class="app-nav app-navigation flex flex-wrap gap-2">
		for _,item := range []struct{ title, href string }{{"Architecture","/"},{"Code","/explore"},{"Review","/review"},{"Rules","/rules"},{"Help","/help"}} {
			<a
				href={ templ.SafeURL(item.href) }
				if item.title == active {
					aria-current="page"
					class="rounded-lg bg-emerald-400 text-slate-950 px-4 py-2 font-medium"
				} else {
					class="rounded-lg bg-slate-800 px-4 py-2"
				}
				if item.title == "Architecture" && active == "Architecture" {
					data-view="architecture"
				}
			>{ item.title }</a>
		}
	</nav>
}
