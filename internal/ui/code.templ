package ui

import (
	"fmt"
	"seamgraph/internal/application"
	"strings"
)

templ CodePage(token string, browser application.CodeBrowser, filter CodeFilter, review *application.ReviewWorkspace) {
 {{ active := codeWorkspaceTab(filter, browser.Base!="", review!=nil) }}
	@pageLayoutWithDiagnostics("Code", token, false, codeDiagnostics(browser, filter)) {
		<main class="review-main code-main">
			@ComparisonControls(false, comparisonBase(browser), comparisonHead(browser), comparisonLink(browser, filter), browser.Base!="") {
				<input type="hidden" name="file" value={ browser.Selected }/>
				<input type="hidden" name="changes" value="1"/>
				<input type="hidden" name="object" value={ browser.Object }/>
				<input type="hidden" name="q" value={ filter.Query }/>
				<input type="hidden" name="kind" value={ filter.Kind }/>
				<input type="hidden" name="visibility" value={ filter.Visibility }/>
				<input type="hidden" name="tools" value={ codeToolsValue(active!="source") }/>
 <input type="hidden" name="tab" value={ active }/>
			}
			<h1>Code explorer</h1>
			if browser.Base!="" {
				<div class="code-tabs" role="tablist" aria-label="Code workspace">
					for _,tab:=range codeTabs(review!=nil) {
						<button type="button" id={ "code-"+tab.ID+"-tab" } data-code-tab={ tab.ID } role="tab" aria-controls={ "code-"+tab.ID+"-panel" } aria-selected={ fmt.Sprint(active==tab.ID) } tabindex={ codeTabIndex(active==tab.ID) }>{ tab.Title }</button>
					}
				</div>
			}

			<p data-code-revision>
				if browser.Base!="" {
					Base: <code data-review-base>{ browser.Base }</code> → Head: <code data-review-head>{ browser.Revision }</code>
				} else {
					Source: { browser.Revision }
				}
			</p>

			<section id="code-source-panel" class="code-source-panel" role="tabpanel" aria-label="Source" if browser.Base!="" {
				aria-labelledby="code-source-tab"
			} hidden?={ active!="source" } tabindex="0">
			<form method="get" action="/explore" class="review-controls">
				if browser.Base!="" {
					<input type="hidden" name="base" value={ browser.ReviewBaseRef }/>
					<input type="hidden" name="revision" value={ browser.ReviewHeadRef }/>
					<label><input type="checkbox" name="changes" value="1" checked?={ filter.ChangesOnly }/>Changes only</label>
				} else {
					<input type="hidden" name="revision" value={ codeRevision(browser) }/>
				}
				<input type="hidden" name="file" value={ browser.Selected }/>
				<input type="hidden" name="object" value={ browser.Object }/>
				<input type="hidden" name="tools" value={ codeToolsValue(active!="source") }/>
 <input type="hidden" name="tab" value={ active }/>
				@CodeFilters(browser, filter)
				<button>Explore</button>
			</form>
				@CodeWorkspace(browser, filter)
			</section>
			if browser.Base!="" {
				@CodeTabPanel("comments", active) { @ChangeComments(browser) }
				if review!=nil {
					@CodeTabPanel("review", active) {
						if browser.Selected!="" {
 @ReviewNote(token, *review)
 }
						@ReviewFindings(*review, filter.CommitType)
					}
					@CodeTabPanel("hotspots", active) { @ReviewHotspots(*review, filter.Query, filter.CommitType) }
					@CodeTabPanel("history", active) { @ReviewHistory(*review, filter.CommitType) }
					@CodeTabPanel("impact", active) { @ReviewImpact(*review, filter.CommitType) }
					@CodeTabPanel("exports", active) {
						<h2>Review exports</h2>
						<nav aria-label="Review exports" class="review-controls">
							for _,format:=range []string{"json","markdown","html"} {
								<a href={ templ.SafeURL(reviewLink(*review, browser.Selected, "", format, filter.CommitType)) }>{ "Export "+format }</a>
							}
						</nav>
						<p>Snapshots include architecture, source evidence, history and saved findings. Download the collected comments from the Comments tab.</p>
					}
				}
			}

		</main>
		if browser.Base!="" && browser.Selected!="" {
			@CommentComposer(token, browser)
		}
	}
}

templ CodeFilters(browser application.CodeBrowser, filter CodeFilter) {
	<label>Search objects<input name="q" value={ filter.Query }/></label>
	<label>
		Symbol kind
		<select name="kind" aria-label="Symbol kind">
			<option value="">All kinds</option>
			for _,kind:=range codeKinds(browser) {
				<option value={ kind } selected?={ kind==filter.Kind }>{ kind }</option>
			}
		</select>
	</label>
	<label>
		Visibility
		<select name="visibility" aria-label="Visibility">
			<option value="">All visibility</option>
			for _,v:=range []string{"public","private"} {
				<option value={ v } selected?={ v==filter.Visibility }>{ v }</option>
			}
		</select>
	</label>
	<label>
		Changed status
		<select name="status" aria-label="Changed status">
			<option value="">All statuses</option>
			for _,v:=range []string{"added","modified","removed","unchanged"} {
				<option value={ v } selected?={ v==filter.Status }>{ v }</option>
			}
		</select>
	</label>
}

templ CodeWorkspace(browser application.CodeBrowser, filter CodeFilter) {
	<div class="review-workspace">
		<aside class="review-tree" aria-label="Code tree">
			@CodeFiles(browser, filter, codeTree(browser, filter), codeTree(browser, filter).Files)
		</aside>
		<section class="review-selection" aria-label="Object details">
			if browser.Selected!="" {
				<div class="code-source-header"><span title={ browser.Selected }>{ browser.Selected }</span>
 if browser.Base!="" {
 <button type="button" data-comment-open>Add comment</button>
 }
</div>
			}
			if selectedCode(browser)!=nil {
				<details class="code-object-details" open?={ filter.View!="" }>
					<summary>Symbol details</summary>
					if object:=selectedCode(browser);object!=nil {
						<h2>{ object.Symbol.ID }</h2>
						<p>{ object.Symbol.Kind } · { object.Symbol.Visibility } · { object.Status }</p>
						<pre data-code-signature>{ object.Symbol.DisplaySignature }</pre>
						if definition:=object.Symbol.Definition;definition!=nil {
							<p data-code-location>{ fmt.Sprintf("%s:%d:%d",definition.Location.File,definition.Location.StartLine,definition.Location.StartColumn) } · { definition.Location.Confidence }</p>
							if definition.Documentation!="" {
								<pre data-code-documentation>{ definition.Documentation }</pre>
							}
						}
						<p>
							Module:
							if object.Symbol.ModuleID=="module:unassigned" {
								Unassigned (no declared owner)
							} else {
								{ object.Symbol.ModuleID }
							}
						</p>
						<p>Declared seams: { strings.Join(object.Seams,", ") }</p>
						@CodeRelationships(browser, filter)
					}
				</details>
			}
			if browser.Selected!="" {
				if browser.Base!="" {
					@UnifiedDiff(browser, filter.ChangesOnly)
				} else {
					@SourceViewer(browser.Content, browser.Selected, codeFocus(browser))
				}
			}
			{ children... }
		</section>
	</div>
}

templ CodeFiles(browser application.CodeBrowser, filter CodeFilter, tree codeTreeView, nodes []*reviewNode) {
	<ul>
		for _,node:=range nodes {
			<li>
				if len(node.Children)>0 {
					<details open?={ (filter.Query!="" || filter.Kind!="" || filter.Visibility!="" || filter.Status!="") || strings.HasPrefix(browser.Selected,node.Path+"/") }>
						<summary data-code-entry="directory">
							@CodeEntryLabel(true, node.Name)
						</summary>
						@CodeFiles(browser, filter, tree, node.Children)
					</details>
				} else {
					<details open?={ browser.Selected==node.Path || filter.Query!="" }>
						<summary data-code-entry="file" data-code-selected?={ browser.Selected==node.Path }>
							<a
								href={ templ.SafeURL(codeLink(browser, filter, node.Path, "")) }
								if browser.Selected==node.Path && browser.Object=="" {
									aria-current="true"
								}
							>
								@CodeEntryLabel(false, node.Name)
							</a> · { node.Status }
						</summary>
						if len(tree.Symbols[node.Path])>0 {
							@CodeSymbols(browser, filter, tree.Symbols[node.Path])
						} else {
							<p class="code-empty">No indexed symbols.</p>
						}
					</details>
				}
			</li>
		}
	</ul>
}

templ CodeSymbols(browser application.CodeBrowser, filter CodeFilter, nodes []*codeSymbolNode) {
	<ul>
		for _,node:=range nodes {
			<li data-code-symbol={ node.Object.Symbol.ID }>
				if len(node.Children)>0 {
					<details open?={ filter.Query!="" || codeAncestor(nodes,browser.Object,node.Object.Symbol.ID) }>
						<summary>
							<a
								href={ templ.SafeURL(codeLink(browser, filter, "", node.Object.Symbol.ID)) }
								if browser.Object==node.Object.Symbol.ID {
									aria-current="true"
								}
							>{ codeName(node.Object) }</a> · { node.Object.Symbol.Kind } · { node.Object.Status }
						</summary>@CodeSymbols(browser, filter, node.Children)
					</details>
				} else {
					<a
						href={ templ.SafeURL(codeLink(browser, filter, "", node.Object.Symbol.ID)) }
						if browser.Object==node.Object.Symbol.ID {
							aria-current="true"
						}
					>{ codeName(node.Object) }</a><span>· { node.Object.Symbol.Kind } · { node.Object.Status }</span>
				}
			</li>
		}
	</ul>
}

templ CodeRelationships(browser application.CodeBrowser, filter CodeFilter) {
	<h3>Focused relationships</h3>
	<p>Consumers and callers show observed static reference sites. Type relationships show inferred structural conformance and do not prove runtime dispatch.</p>
	<nav aria-label="Relationship views" class="review-controls">
		for _,v:=range []struct{value,label string}{{"consumers","Consumers"},{"callers","Callers"},{"outgoing","References from"},{"types","Type relationships"}} {
			<a href={ templ.SafeURL(codeLink(browser, CodeFilter{Query: filter.Query, Kind: filter.Kind, Visibility: filter.Visibility, Status: filter.Status, View: v.value, ChangesOnly: filter.ChangesOnly, Tools: filter.Tools, CommitType: filter.CommitType}, "", browser.Object)) }>{ v.label }</a>
		}
	</nav>
	<p>View: { filter.View } · Evidence revision: { browser.RelationshipRevision }. Each arrow below is backed by the displayed source evidence.</p>
	for _,relation:=range codeReferences(browser,filter.View) {
		<article data-code-relation>
			<p><a href={ templ.SafeURL(codeLink(browser, filter, "", relation.FromID)) }>{ relation.FromID }</a> → <a href={ templ.SafeURL(codeLink(browser, filter, "", relation.ToID)) }>{ relation.ToID }</a> · { relation.Kind }</p>
			for _,e:=range relation.Evidence {
				<p><a href={ templ.SafeURL(codeLink(browser, filter, e.File, "")) }>{ fmt.Sprintf("%s:%d:%d · %s/%s · %s",e.File,e.StartLine,e.StartColumn,e.Confidence,e.Resolution,e.Kind) }</a></p>
			}
		</article>
	}
}

templ CodeEntryLabel(directory bool, name string) {
	<svg class="code-entry-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
		if directory {
			<path d="M2 5a1 1 0 0 1 1-1h5l2 2h7a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1Z"></path>
		} else {
			<path d="M5 2h6l4 4v12H5ZM11 2v5h4M8 11h4M8 14h4"></path>
		}
	</svg>
	{ name }
}


templ CodeTabPanel(id, active string) {
 <section id={ "code-"+id+"-panel" } class="code-review-panel" role="tabpanel" aria-labelledby={ "code-"+id+"-tab" } hidden?={ active!=id } tabindex="0">
  { children... }
 </section>
}
