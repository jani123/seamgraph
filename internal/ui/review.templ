package ui

import (
	"fmt"
	"seamgraph/internal/application"
	"strings"
)

templ ReviewHotspots(r application.ReviewWorkspace, query, kind string) {
	<section>
		<h2>Branch hotspots</h2>
		<p>{ r.Activity.Policy }. Frequency counts commits; churn counts additions plus deletions, including reverted work. Paths are not followed across renames. Binary line statistics are unknown. Unassigned, generated and vendor paths remain included. Table sorts by frequency, then path.</p>
		if r.Activity.Unavailable != "" {
			<p role="status">{ r.Activity.Unavailable }</p>
		}
		@ReviewCommitFilters(r, kind)
		<p>Commit type filtering selects hotspot paths touched by those commits; each row retains its full-range totals.</p>
		<div class="review-table">
			<table>
				<thead><tr><th>Path</th><th>Touches</th><th>Added</th><th>Deleted</th><th>Churn</th><th>Final net +/−</th></tr></thead>
				<tbody>
					for _,h := range r.Hotspots {
						if hotspotVisible(r,h,kind,query) {
							<tr data-hotspot-path={ h.Path }>
								<td><a data-code-tab-link="source" href={ templ.SafeURL(reviewLink(r, h.Path, "", "", kind)) }>{ h.Path }</a></td>
								<td>{ fmt.Sprint(h.Touches) }</td>
								if h.Binary {
									<td colspan="3">Unknown (binary)</td>
								} else {
									<td>{ fmt.Sprint(h.Added) }</td>
									<td>{ fmt.Sprint(h.Deleted) }</td>
									<td>{ fmt.Sprint(h.Churn) }</td>
								}
								<td>
									if h.Net.Binary {
										Unknown (binary)
									} else {
										{ fmt.Sprintf("+%d / −%d",h.Net.Added,h.Net.Deleted) }
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ ReviewHistory(r application.ReviewWorkspace) {
 {{ commits := reviewCommits(r, "") }}
	<section aria-label="Touching commits">
		<h2>Commits</h2>
		if r.Activity.Unavailable!="" {
			<p role="status">{ r.Activity.Unavailable }</p>
		}
		if len(commits)==0 && r.Activity.Unavailable=="" {
 <p>No commits in this selection.</p>
 }
 for _,c := range commits {
			<article data-review-commit={ c.Revision } class="history-commit">
				<h3>{ strings.SplitN(c.Message,"\n",2)[0] }</h3>
				<code>{ c.Revision[:min(12,len(c.Revision))] }</code>
				if c.Breaking {
					<strong class="history-breaking">Breaking change</strong>
				}
				if body:=reviewCommitBody(c.Message);body!="" {
					<p class="history-message">{ body }</p>
				}
				<details data-commit-files>
					<summary>{ fmt.Sprintf("Affected files (%d)", len(c.Files)) }</summary>
					<ul>
						for path,stats := range c.Files {
							<li>
								<a data-code-tab-link="source" href={ templ.SafeURL(historySourceLink(c,path)) } title="Open this commit's file in Source">{ path }</a>
								if stats.Binary {
									Unknown (binary)
								} else {
									{ fmt.Sprintf("+%d / −%d",stats.Added,stats.Deleted) }
								}
							</li>
						}
					</ul>
				</details>
			</article>
		}
	</section>
}

templ ReviewFindings(r application.ReviewWorkspace, kind string) {
	<section aria-label="Review findings">
		<h2>Review findings and viewed files</h2>
		for _,mark := range r.Marks {
 if !mark.Entry.Comment {
			<article data-review-mark={ mark.Entry.File }>
				<h3>
					if mark.Status == "anchor unavailable" {
						{ mark.Entry.File }
					} else {
						<a data-code-tab-link="source" href={ templ.SafeURL(reviewLink(r, mark.Entry.File, "", "", kind)) }>{ mark.Entry.File }</a>
					}
				</h3>
				<p>{ mark.Status } · viewed: { fmt.Sprint(mark.Entry.Viewed) } · resolved: { fmt.Sprint(mark.Entry.Resolved) }</p>
				<pre>{ mark.Entry.Note }</pre><details><summary>Original anchor</summary><p>{ mark.Entry.Base } to { mark.Entry.Head } · { mark.Entry.RecordedAt }</p><pre>{ mark.Entry.Context }</pre></details>
			</article>
 }
		}
	</section>
}

templ ReviewImpact(r application.ReviewWorkspace, kind string) {
	if r.Object != nil {
		<section data-review-object>
			<h3>Observed architecture references</h3>
			for _,rel := range r.References {
				<p>{ rel.Kind } · { rel.FromID } → { rel.ToID }</p>
			}
			<h3>Possible transitive module impact</h3>
			<p>{ strings.Join(r.PossibleImpact,", ") }</p>
		</section>
	}
	<section>
		<h2>Architecture impact and contract changes</h2>
		for _,id := range reviewSubjects(r) {
			<p><a data-code-tab-link="source" href={ templ.SafeURL(reviewLink(r, r.Selected, id, "", kind)) }>{ id }</a></p>
		}
		<details><summary>Complete architecture comparison and source evidence</summary><pre>{ comparisonJSON(r.Comparison) }</pre></details>
	</section>
}

templ ReviewNote(token string, r application.ReviewWorkspace) {
	<form method="post" action="/review" class="review-note">
		<h3>File review</h3>
		<input type="hidden" name="token" value={ token }/><input type="hidden" name="baseRef" value={ r.BaseRef }/><input type="hidden" name="headRef" value={ r.HeadRef }/><input type="hidden" name="base" value={ r.Comparison.Base }/><input type="hidden" name="head" value={ r.Comparison.Head }/><input type="hidden" name="file" value={ r.Selected }/>
		<label>Review note<textarea name="note" maxlength="8000">{ reviewMark(r,r.Selected).Entry.Note }</textarea></label>
		<label><input type="checkbox" name="viewed" checked?={ reviewMark(r,r.Selected).Entry.Viewed }/> Viewed</label>
		<label><input type="checkbox" name="resolved" checked?={ reviewMark(r,r.Selected).Entry.Resolved }/> Resolved</label>
		<button>Save file review</button>
		<p>Saving acknowledges the current comparison. Earlier notes and source context remain in the local append-only log.</p>
	</form>
}

templ ReviewSnapshot(r application.ReviewWorkspace) {
	<!DOCTYPE html>
	<html lang="en">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>SeamGraph review snapshot</title></head>
		<body>
			<h1>Local review snapshot</h1>
			<p>Two-tree comparison: { r.Comparison.Base } to { r.Comparison.Head }</p>
			<p>Contains complete architecture and reference evidence, history, review findings and original anchors. Full source is included only for the selected file: { r.Selected }. Saved findings also include original bounded source excerpts.</p>
			<pre>{ application.ReviewJSON(r) }</pre>
		</body>
	</html>
}


templ ReviewCommitFilters(r application.ReviewWorkspace, kind string) {
		<nav aria-label="Commit type filters" class="review-controls">
			<a href={ templ.SafeURL(reviewLink(r, r.Selected, "", "", "")) }>All commit types</a>
			for _,t := range reviewTypes(r) {
				<a href={ templ.SafeURL(reviewLink(r, r.Selected, "", "", t)) }>{ fmt.Sprintf("%s (%d commits)",t,reviewTypeCount(r,t)) }</a>
			}
		</nav>
}
