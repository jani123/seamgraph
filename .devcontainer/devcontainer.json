{
  "name": "SeamGraph development",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/seamgraph",
  "shutdownAction": "stopCompose",
  "remoteUser": "devbox",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=seamgraph-devbox-${devcontainerId},target=/workspaces/seamgraph/.devbox,type=volume",
    "source=seamgraph-cache-${devcontainerId},target=/home/devbox/.cache,type=volume",
    "source=seamgraph-go-${devcontainerId},target=/home/devbox/go,type=volume",
    "source=seamgraph-npm-${devcontainerId},target=/home/devbox/.local/npm,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/prepare.sh",
  "postStartCommand": "python3 .devcontainer/start-dev.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "jetpack-io.devbox",
        "golang.go",
        "a-h.templ"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "Devbox",
        "terminal.integrated.profiles.linux": {
          "Devbox": {
            "path": "/usr/local/bin/devbox",
            "args": [
              "shell"
            ]
          }
        },
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "process"
      }
    }
  },
  "portsAttributes": {
    "8765": {
      "label": "SeamGraph dev",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": false
    },
    "8766": {
      "label": "Order fulfillment",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": false
    },
    "8767": {
      "label": "Fulfillment working changes",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": false
    },
    "8768": {
      "label": "Fulfillment large graph",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": false
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "notify",
    "requireLocalPort": false
  },
  "forwardPorts": [
    8765,
    8766,
    8767,
    8768
  ]
}
